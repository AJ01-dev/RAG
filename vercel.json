{
  "buildCommand": "cd web-app && npm install && npm run build",
  "outputDirectory": "web-app/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rag-backend-9r2g.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
